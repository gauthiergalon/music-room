  "query": "\n        SELECT r.current_track, r.is_playing, r.current_position, r.played_at,\n               t.title AS \"title?\", t.artist AS \"artist?\", t.album AS \"album?\",\n               t.cover AS \"cover?\", t.duration AS \"duration?\"\n        FROM rooms r\n        LEFT JOIN tracks t ON t.id = r.current_track\n        WHERE r.id = $1\n        ",
