  "query": "\n        INSERT INTO friends (user_id_1, user_id_2, sender_id, is_pending)\n        VALUES ($1, $2, $3, true)\n        ON CONFLICT (user_id_1, user_id_2) DO UPDATE\n        SET is_pending = false\n        WHERE friends.is_pending = true AND friends.sender_id != EXCLUDED.sender_id\n        RETURNING *\n        ",
