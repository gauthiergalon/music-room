JWT_SECRET=change-me-to-a-long-random-string

# With `docker compose up`, the backend reaches the other services by their
# service name: use `postgres`, `hifi-api:8000` and `mailhog` as hosts below.
# Use `localhost` when the backend runs on the host with `cargo run`.
DATABASE_URL=postgresql://musicroom:secret@postgres:5432/musicroom
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=secret
# DB_MAX_CONNECTIONS=10

GOOGLE_CLIENT_ID=clientId
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# host[:port] of the HiFi API, without scheme
HIFI_API_HOST=hifi-api:8000
HIFI_API_CLIENT_ID=
HIFI_API_CLIENT_SECRET=
HIFI_API_USER_ID=
HIFI_API_ACCESS_TOKEN=
HIFI_API_REFRESH_TOKEN=

# Email. The defaults target Mailhog (port 1025, no TLS, no credentials).
SMTP_HOST=mailhog
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # none | starttls | tls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Music Room <noreply@musicroom.app>

# Domains the web audio relay may fetch from (comma separated). The web app
# cannot reach the provider's CDN itself, so the backend relays its streams.
# STREAM_PROXY_ALLOWED_HOSTS=tidal.com

# Requests per minute and per client on login/register/password-reset.
# 0 disables the limit (needed for the k6 load test).
# AUTH_RATE_LIMIT_PER_MINUTE=30

# Comma-separated origins allowed by CORS; unset or * allows any.
# CORS_ALLOWED_ORIGINS=https://app.example.com
