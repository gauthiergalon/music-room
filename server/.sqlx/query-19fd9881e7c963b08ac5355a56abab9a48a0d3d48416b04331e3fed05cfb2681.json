{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT q.id, q.track_id, q.position,\n               t.title AS \"title?\", t.artist AS \"artist?\", t.album AS \"album?\",\n               t.cover AS \"cover?\", t.duration AS \"duration?\"\n        FROM queue q\n        LEFT JOIN tracks t ON t.id = q.track_id\n        WHERE q.room_id = $1\n        ORDER BY q.position ASC\n        ",
